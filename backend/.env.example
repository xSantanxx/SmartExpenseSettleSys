DATABASE_URL=postgres://sess:sess@localhost:5433/smart_expense
PORT=3001
NODE_ENV=development

# Required in production. Long random string used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Production: your Vercel/Netlify site origin(s), comma-separated.
# FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional: bcrypt cost (default 10). Lower only for local tests.
# BCRYPT_ROUNDS=10

# Subscription email reminders (optional — UI works without these)
# CRON_SECRET=long-random-string
# RESEND_API_KEY=re_...
# REMINDER_FROM_EMAIL=Smart Expense <onboarding@resend.dev>
