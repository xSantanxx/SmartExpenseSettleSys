{
  "name": "smart-expense-settlement-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for Smart Expense Settlement System",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "start": "tsx src/db/migrate.ts && tsx src/server.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/domain src/auth src/app.test.ts",
    "test:integration": "vitest run src/api.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "PATH=\"$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH\" docker compose -f ../docker-compose.yml up -d",
    "db:down": "PATH=\"$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH\" docker compose -f ../docker-compose.yml down",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
